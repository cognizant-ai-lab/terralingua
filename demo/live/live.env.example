# Template for demo/live/live.env. Copy it, fill in the secrets, and pass it to
# the container with `docker run --env-file demo/live/live.env` (demo/live/run.sh
# does this for you). live.env itself is NOT committed — it holds credentials.
#
#   cp demo/live/live.env.example demo/live/live.env
#   # then fill in the four secrets below
#
# Non-secret config (EXP_NAME, RESUME, runner/anthropologist/API knobs) lives in
# the Dockerfile's ENV. Edit it there, or override per run with
# `docker run -e EXP_NAME=... -e RESUME=...`.

# ── Secrets (REQUIRED — the entrypoint refuses to boot if any is empty) ───────
# Generate once, pin them, treat them like credentials. Changing them between
# restarts silently invalidates all stored user API keys and sessions.
#   FERNET_SECRET_KEY  → python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   JWT_SECRET         → python -c "import secrets; print(secrets.token_hex(32))"
#   SESSION_SECRET     → python -c "import secrets; print(secrets.token_hex(32))"
#   POSTGRES_PASSWORD  → python -c "import secrets; print(secrets.token_urlsafe(32))"
FERNET_SECRET_KEY=
JWT_SECRET=
SESSION_SECRET=
POSTGRES_PASSWORD=

# ── Optional: platform-wide Anthropic key ─────────────────────────────────────
# Not required — each registered user supplies their own from the dashboard.
# ANTHROPIC_API_KEY=sk-ant-...
