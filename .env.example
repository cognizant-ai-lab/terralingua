# Required for OpenAI-based models (gpt-*, o3-*, o4-*)
OPENAI_API_KEY=your_openai_key_here

# Required for Anthropic-based models (claude-*)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Needed only by the dashboard (terralingua-dashboard). Generate the secrets once and keep them.
# DATABASE_URL=postgresql://user:password@localhost:5432/terralingua
# SESSION_SECRET=   # python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET=       # python -c "import secrets; print(secrets.token_hex(32))"
# FERNET_SECRET_KEY=   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
